---

<Layout>
	<div id="top">
		<!-- HERO -->
		<section data-r="hero" style="display:grid;grid-template-columns:1.62fr 1fr;gap:20px;margin-bottom:20px">
			<div data-pad style="position:relative;background:linear-gradient(150deg,var(--heroA) 0%,var(--heroB) 118%);border:1px solid var(--heroLine);border-radius:26px;padding:44px;box-shadow:var(--shadow);overflow:hidden">
				<div style="position:absolute;top:22px;right:26px;font:500 10px/1 'JetBrains Mono',monospace;letter-spacing:.2em;color:var(--tx3)">01 / PERFIL</div>
				<div style="display:inline-flex;align-items:center;gap:9px;background:color-mix(in srgb, var(--blue) 13%, transparent);border:1px solid color-mix(in srgb, var(--blue) 35%, transparent);color:var(--blue);border-radius:999px;padding:8px 16px;font:600 10.5px/1 'JetBrains Mono',monospace;letter-spacing:.18em">
					<span style="width:6px;height:6px;border-radius:50%;background:var(--blue);animation:mhpulse 2s infinite"></span>
					<span data-l="es">DISPONIBLE PARA PROYECTOS</span><span data-l="en">AVAILABLE FOR PROJECTS</span>
				</div>
				<h1 data-h1 style="font:700 72px/0.98 'Space Grotesk',sans-serif;letter-spacing:-.035em;margin:26px 0 0;text-wrap:balance">
					<span data-l="es">Diseñando el<br /><span style="display:inline-block;padding-bottom:.14em;margin-bottom:-.14em;color:var(--blue);animation:mhtype 1.15s steps(14) .35s both">futuro digital</span>.</span>
					<span data-l="en">Designing the<br /><span style="display:inline-block;padding-bottom:.14em;margin-bottom:-.14em;color:var(--blue);animation:mhtype 1.15s steps(14) .35s both">digital future</span>.</span>
					<span style="display:inline-block;width:.06em;height:.82em;margin-left:.06em;vertical-align:-.04em;background:var(--blue);animation:mhcaret 1s step-end 1.5s infinite"></span>
				</h1>
				<p style="max-width:560px;margin:26px 0 0;font:400 17px/1.62 Manrope,sans-serif;color:var(--tx2);text-wrap:balance;hyphens:none">
					<span data-l="es">Diseñador UX/UI con más de 13 años en producto digital: investigación, prototipado de alta fidelidad, sistemas de diseño y flujos centrados en el usuario para banca, gobierno, legaltech y media.</span>
					<span data-l="en">UX/UI designer with 13+ years in digital product: research, high-fidelity prototyping, design systems and user-centered flows for banking, government, legaltech and media.</span>
				</p>
				<div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:32px">
					<a class="hv-btn" href="#proyectos" style="display:inline-flex;align-items:center;gap:10px;background:var(--blue);color:var(--onacc);border-radius:14px;padding:15px 24px;font:600 13px/1 'Space Grotesk',sans-serif;letter-spacing:.06em">
						<span data-l="es">VER PROYECTOS</span><span data-l="en">VIEW PROJECTS</span><span style="font-family:'JetBrains Mono',monospace">→</span>
					</a>
					<a class="hv-soft" href="/uploads/CV_Marco_Hernandez.docx.pdf" target="_blank" rel="noopener" style="display:inline-flex;align-items:center;gap:10px;border:1px solid var(--line);border-radius:14px;padding:15px 24px;font:600 13px/1 'Space Grotesk',sans-serif;letter-spacing:.06em;color:var(--tx2)">
						<span data-l="es">DESCARGAR CV</span><span data-l="en">DOWNLOAD CV</span><span style="font-family:'JetBrains Mono',monospace">↓</span>
					</a>
				</div>
			</div>

			<div data-pad style="position:relative;background:var(--panel);border:1px solid var(--line);border-radius:26px;padding:32px;box-shadow:var(--shadow);display:flex;flex-direction:column;align-items:center;text-align:center">
				<div style="position:absolute;top:22px;right:26px;font:500 10px/1 'JetBrains Mono',monospace;letter-spacing:.2em;color:var(--tx3)">02 / IDENTIDAD</div>
				<div style="position:relative;width:132px;height:132px;margin-top:22px;border-radius:26px;overflow:hidden;border:1px solid var(--line);background:var(--panel2)">
					<img src="/assets/marco-perfil.jpg" width="132" height="132" alt="Marco Antonio Hernández Juárez" style="width:100%;height:100%;object-fit:cover;display:block" />
					<div style="position:absolute;inset:0;box-shadow:inset 0 -70px 90px -30px rgba(7,12,34,.62)"></div>
				</div>
				<div style="font:700 25px/1.1 'Space Grotesk',sans-serif;letter-spacing:-.02em;margin-top:24px">Marco Hernández</div>
				<div style="font:500 10.5px/1.5 'JetBrains Mono',monospace;letter-spacing:.16em;color:var(--tx2);margin-top:10px">UX/UI · IA GENERATIVA<br />PROMPT ENGINEERING</div>
				<div style="font:400 12.5px/1 Manrope,sans-serif;color:var(--tx3);margin-top:14px">San Pedro Cholula, Puebla · MX</div>
				<div style="display:flex;gap:9px;margin-top:auto;padding-top:28px">
					<a class="hv-fill" href="https://www.behance.net/marcohj" target="_blank" rel="noopener" aria-label="Behance" style="width:44px;height:44px;display:grid;place-items:center;background:var(--panel2);border:1px solid var(--line);border-radius:13px;font:600 11px/1 'Space Grotesk',sans-serif;color:var(--tx2)">Bē</a>
					<a class="hv-fill" href="https://linkedin.com/in/marcohj84" target="_blank" rel="noopener" aria-label="LinkedIn" style="width:44px;height:44px;display:grid;place-items:center;background:var(--panel2);border:1px solid var(--line);border-radius:13px;font:600 11px/1 'Space Grotesk',sans-serif;color:var(--tx2)">in</a>
					<a class="hv-fill" href="https://github.com/markohj84" target="_blank" rel="noopener" aria-label="GitHub" style="width:44px;height:44px;display:grid;place-items:center;background:var(--panel2);border:1px solid var(--line);border-radius:13px;color:var(--tx2)">
						<svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1.8a10.2 10.2 0 0 0-3.23 19.89c.51.09.7-.22.7-.49v-1.9c-2.84.62-3.44-1.2-3.44-1.2-.47-1.18-1.14-1.5-1.14-1.5-.93-.63.07-.62.07-.62 1.03.07 1.57 1.06 1.57 1.06.92 1.57 2.4 1.12 2.99.86.09-.67.36-1.12.65-1.38-2.27-.26-4.65-1.14-4.65-5.05 0-1.12.4-2.03 1.05-2.75-.11-.26-.46-1.3.1-2.71 0 0 .85-.27 2.79 1.05a9.7 9.7 0 0 1 5.08 0c1.94-1.32 2.79-1.05 2.79-1.05.56 1.41.21 2.45.1 2.71.65.72 1.05 1.63 1.05 2.75 0 3.92-2.39 4.78-4.67 5.04.37.32.7.94.7 1.9v2.82c0 .27.19.59.71.49A10.2 10.2 0 0 0 12 1.8Z" /></svg>
					</a>
					<a class="hv-fill" href="https://wa.me/522223576770" target="_blank" rel="noopener" aria-label="WhatsApp" style="width:44px;height:44px;display:grid;place-items:center;background:var(--panel2);border:1px solid var(--line);border-radius:13px;font:600 10px/1 'JetBrains Mono',monospace;color:var(--tx2)">WA</a>
				</div>
			</div>
		</section>

		<!-- MÉTODO + CV -->
		<section data-r="2" id="sobre" style="display:grid;grid-template-columns:1.62fr 1fr;gap:20px;margin-bottom:20px">
			<div data-pad style="background:var(--panel);border:1px solid var(--line);border-radius:26px;padding:40px;position:relative">
				<div style="position:absolute;top:22px;right:26px;font:500 10px/1 'JetBrains Mono',monospace;letter-spacing:.2em;color:var(--tx3)">03 / MÉTODO</div>
				<h2 style="font:700 34px/1.05 'Space Grotesk',sans-serif;letter-spacing:-.03em;margin:0">
					<span data-l="es">Cómo trabajo.</span><span data-l="en">How I work.</span>
				</h2>
				<p style="max-width:620px;margin:16px 0 34px;font:400 15.5px/1.62 Manrope,sans-serif;color:var(--tx2);text-wrap:balance;hyphens:none">
					<span data-l="es">He trabajado en productos para Banorte, Volkswagen de México, TV Azteca Puebla, Buholegal y el sistema de atención ciudadana del Gobierno de Cancún. El proceso siempre es el mismo: entender, validar, sistematizar y entregar sin fricción.</span>
					<span data-l="en">I have worked on products for Banorte, Volkswagen México, TV Azteca Puebla, Buholegal and the citizen service system of the Cancún Government. The process is always the same: understand, validate, systematize and hand off without friction.</span>
				</p>
				<div data-r="2" style="display:grid;grid-template-columns:1fr 1fr;gap:26px 34px">
					{method.map((m) => (
						<div style="border-left:2px solid var(--blue);padding-left:16px">
							<div style="font:600 12px/1 'JetBrains Mono',monospace;letter-spacing:.14em;margin-bottom:9px"><span data-l="es">{m.t.es}</span><span data-l="en">{m.t.en}</span></div>
							<div style="font:400 14px/1.55 Manrope,sans-serif;color:var(--tx2)"><span data-l="es">{m.d.es}</span><span data-l="en">{m.d.en}</span></div>
						</div>
					))}
				</div>
			</div>

			<div style="display:flex;flex-direction:column;gap:20px">
				<div data-r="stats" style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
					<div style="background:var(--panel);border:1px solid var(--line);border-radius:22px;padding:26px;text-align:center">
						<div style="font:700 46px/1 'Space Grotesk',sans-serif;color:var(--blue);letter-spacing:-.04em">13+</div>
						<div style="font:600 10px/1.4 'JetBrains Mono',monospace;letter-spacing:.14em;color:var(--tx2);margin-top:10px"><span data-l="es">AÑOS DE<br />EXPERIENCIA</span><span data-l="en">YEARS OF<br />EXPERIENCE</span></div>
					</div>
					<div style="background:var(--panel);border:1px solid var(--line);border-radius:22px;padding:26px;text-align:center">
						<div style="font:700 46px/1 'Space Grotesk',sans-serif;color:var(--blue);letter-spacing:-.04em">13</div>
						<div style="font:600 10px/1.4 'JetBrains Mono',monospace;letter-spacing:.14em;color:var(--tx2);margin-top:10px"><span data-l="es">CASOS<br />PUBLICADOS</span><span data-l="en">PUBLISHED<br />CASES</span></div>
					</div>
				</div>
				<a href="/uploads/CV_Marco_Hernandez.docx.pdf" target="_blank" rel="noopener" data-pad class="hv-w" style="flex:1;background:linear-gradient(150deg,var(--ctaA) 0%,var(--ctaB) 100%);border-radius:26px;padding:32px;color:#ffffff;display:flex;flex-direction:column;position:relative;overflow:hidden">
