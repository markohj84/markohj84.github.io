const sectionGrid = "display:grid;grid-template-columns:minmax(0,220px) 1fr;gap:56px;padding:78px 4px 20px";
const bigNum = "font:300 96px/0.82 'Space Grotesk',sans-serif;letter-spacing:-.05em;color:var(--tx)";
const sectionLabel = "font:500 14px/1 'Space Grotesk',sans-serif;letter-spacing:.3em;color:var(--tx2);margin-top:10px";
