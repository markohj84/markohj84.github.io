---
import Layout from "../layouts/Layout.astro";

const channels = [
	{ label: "Email", value: "tu@email.com", href: "mailto:tu@email.com" },
	{ label: "GitHub", value: "github.com/tu-usuario", href: "https://github.com/tu-usuario" },
	{ label: "LinkedIn", value: "linkedin.com/in/tu-usuario", href: "https://linkedin.com/in/tu-usuario" },
];
---

<Layout title="Contacto — Tu Nombre" description="Formas de contactar a Tu Nombre.">
	<h1 class="text-2xl font-bold tracking-tight text-neutral-50">Contacto</h1>
	<p class="mt-4 max-w-xl text-neutral-400">
		¿Tienes un proyecto en mente o quieres platicar? Escríbeme por cualquiera de estos medios.
	</p>

	<ul class="mt-8 space-y-4">
		{
			channels.map((channel) => (
				<li class="flex items-center justify-between border-b border-neutral-800 pb-4">
					<span class="text-sm text-neutral-500">{channel.label}</span>
					<a
						href={channel.href}
						target="_blank"
						rel="noopener noreferrer"
						class="text-sm text-neutral-200 underline underline-offset-4 hover:text-neutral-50"
					>
						{channel.value}
					</a>
				</li>
			))
		}
	</ul>
</Layout>
