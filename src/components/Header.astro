---
const navItems = [
	{ href: "/", label: "Inicio" },
	{ href: "/proyectos", label: "Proyectos" },
	{ href: "/sobre-mi", label: "Sobre mí" },
	{ href: "/contacto", label: "Contacto" },
];

const currentPath = Astro.url.pathname;
---

<header class="border-b border-neutral-800">
	<nav class="mx-auto flex w-full max-w-4xl items-center justify-between px-6 py-5">
		<a href="/" class="text-sm font-semibold tracking-tight text-neutral-100">
			Tu Nombre
		</a>
		<ul class="flex gap-6 text-sm text-neutral-400">
			{
				navItems.map((item) => (
					<li>
						<a
							href={item.href}
							class:list={[
								"transition-colors hover:text-neutral-100",
								{
									"text-neutral-100": currentPath === item.href,
								},
							]}
						>
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</header>
