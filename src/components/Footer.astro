---
const year = new Date().getUTCFullYear();
const social = [
	{ label: "GitHub", href: "https://github.com/tu-usuario" },
	{ label: "LinkedIn", href: "https://linkedin.com/in/tu-usuario" },
	{ label: "Email", href: "mailto:tu@email.com" },
];
---

<footer class="border-t border-neutral-800">
	<div class="mx-auto flex w-full max-w-4xl flex-col gap-4 px-6 py-8 text-sm text-neutral-500 sm:flex-row sm:items-center sm:justify-between">
		<p>&copy; {year} Tu Nombre. Todos los derechos reservados.</p>
		<ul class="flex gap-4">
			{
				social.map((item) => (
					<li>
						<a href={item.href} class="transition-colors hover:text-neutral-200" target="_blank" rel="noopener noreferrer">
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</div>
</footer>
