---
import type { Project } from "../data/projects";

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<article class="rounded-lg border border-neutral-800 p-6 transition-colors hover:border-neutral-700">
	<h3 class="text-lg font-semibold text-neutral-100">{project.title}</h3>
	<p class="mt-2 text-sm leading-relaxed text-neutral-400">{project.description}</p>
	<ul class="mt-4 flex flex-wrap gap-2">
		{
			project.tags.map((tag) => (
				<li class="rounded-full border border-neutral-800 px-2.5 py-0.5 text-xs text-neutral-400">
					{tag}
				</li>
			))
		}
	</ul>
	<div class="mt-4 flex gap-4 text-sm">
		{project.url && (
			<a href={project.url} target="_blank" rel="noopener noreferrer" class="text-neutral-300 underline underline-offset-4 hover:text-neutral-100">
				Ver sitio
			</a>
		)}
		{project.repo && (
			<a href={project.repo} target="_blank" rel="noopener noreferrer" class="text-neutral-300 underline underline-offset-4 hover:text-neutral-100">
				Código
			</a>
		)}
	</div>
</article>
