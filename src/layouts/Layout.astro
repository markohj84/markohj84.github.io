---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = "Marco Hernández — Diseñador UX/UI",
	description =
		"Diseñador UX/UI con más de 13 años en producto digital: investigación, prototipado, sistemas de diseño e IA generativa para banca, gobierno, legaltech y media.",
	image = "/assets/marco-perfil.jpg",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://markohj84.github.io");
---

<html lang="es" data-theme="dark" data-lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, canonical)} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary_large_image" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Manrope:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>

		<!-- Preferencias antes del primer pintado: evita el parpadeo de tema/idioma. -->
		<script is:inline>
			(() => {
				const r = document.documentElement;
				try {
					r.dataset.theme = localStorage.getItem("mh_theme") || "dark";
					r.dataset.lang = localStorage.getItem("mh_lang") || "es";
				} catch (e) {}
				// Sólo se ocultan las secciones si vamos a poder revelarlas.
				if ("IntersectionObserver" in window) r.classList.add("js-reveal");
			})();
		</script>
	</head>

	<body>
		<div data-shell style="max-width:1320px;margin:0 auto;padding:26px 26px 160px">
			<header style="display:flex;align-items:center;justify-content:space-between;gap:10px;padding:8px 4px 34px">
				<a
					href="/"
					data-logo
					style="display:inline-flex;align-items:baseline;gap:1px;font:700 24px/1 'Space Grotesk',sans-serif;letter-spacing:-.03em;white-space:nowrap"
				>
					<span style="display:inline-block;padding-bottom:.14em;margin-bottom:-.14em;animation:mhtype .5s steps(5) both">Marco</span>
					<span style="display:inline-block;color:var(--tx3);font-weight:400;margin:0 3px;animation:mhtype .1s steps(1) .5s both">/</span>
					<span style="display:inline-block;padding-bottom:.14em;margin-bottom:-.14em;color:var(--blue);animation:mhtype .85s steps(9) .6s both">Hernández</span>
				</a>

				<div style="display:flex;align-items:center;gap:10px">
					<button
						id="mh-lang"
						aria-label="Cambiar idioma / Switch language"
						style="display:flex;align-items:center;gap:0;background:var(--panel);border:1px solid var(--line);border-radius:999px;padding:5px;cursor:pointer;font-family:'JetBrains Mono',monospace"
					>
						<span data-pill="es">ES</span>
						<span data-pill="en">EN</span>
					</button>
					<button
						id="mh-theme"
						aria-label="Cambiar tema / Toggle theme"
						class="hv-blue"
						style="width:42px;height:42px;display:grid;place-items:center;background:var(--panel);border:1px solid var(--line);border-radius:14px;color:var(--tx2);cursor:pointer;font-size:15px"
					></button>
				</div>
			</header>

			<slot />
		</div>

		<nav
			style="position:fixed;left:50%;bottom:24px;transform:translateX(-50%);z-index:60;display:flex;gap:4px;background:var(--navbg);backdrop-filter:blur(26px) saturate(180%);-webkit-backdrop-filter:blur(26px) saturate(180%);border:1px solid var(--navline);border-radius:999px;padding:7px;box-shadow:0 18px 44px rgba(0,0,0,.35),inset 0 1px 0 rgba(255,255,255,.14)"
		>
			<a class="hv-fill2" aria-label="Inicio / Home" href="/#top" style="border-radius:999px;padding:11px 17px;font:600 11px/1 'JetBrains Mono',monospace;letter-spacing:.1em"><svg data-ico width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 10.5 12 3.5l8.5 7"/><path d="M5.5 9.5V20h13V9.5"/><path d="M9.5 20v-6h5v6"/></svg><span data-txt><span data-l="es">INICIO</span><span data-l="en">HOME</span></span></a>
			<a class="hv-fill2" aria-label="Servicios / Services" href="/#servicios" style="border-radius:999px;padding:11px 17px;font:600 11px/1 'JetBrains Mono',monospace;letter-spacing:.1em"><svg data-ico width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="3" width="7.5" height="7.5" rx="2"/><rect x="3" y="13.5" width="7.5" height="7.5" rx="2"/><rect x="13.5" y="13.5" width="7.5" height="7.5" rx="2"/></svg><span data-txt><span data-l="es">SERVICIOS</span><span data-l="en">SERVICES</span></span></a>
			<a class="hv-fill2" aria-label="Proyectos / Work" href="/#proyectos" style="border-radius:999px;padding:11px 17px;font:600 11px/1 'JetBrains Mono',monospace;letter-spacing:.1em"><svg data-ico width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7.5a2 2 0 0 1 2-2h3.6l1.9 2.2H19a2 2 0 0 1 2 2v7.8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z"/></svg><span data-txt><span data-l="es">PROYECTOS</span><span data-l="en">WORK</span></span></a>
			<a class="hv-fill2" href="/#experiencia" style="border-radius:999px;padding:11px 17px;font:600 11px/1 'JetBrains Mono',monospace;letter-spacing:.1em">CV</a>
			<a class="hv-btn" href="/#contacto" style="border-radius:999px;padding:11px 17px;font:600 11px/1 'JetBrains Mono',monospace;letter-spacing:.1em"><span data-l="es">CONTACTO</span><span data-l="en">CONTACT</span></a>
		</nav>

		<script is:inline>
			(() => {
				const r = document.documentElement;
				const ON = "padding:7px 13px;border-radius:999px;font:600 11px/1;letter-spacing:.08em;background:var(--blue);color:var(--onacc)";
				const OFF = "padding:7px 13px;border-radius:999px;font:600 11px/1;letter-spacing:.08em;background:transparent;color:var(--tx2)";
				const themeBtn = document.getElementById("mh-theme");
				const langBtn = document.getElementById("mh-lang");
				const pills = { es: langBtn.querySelector('[data-pill="es"]'), en: langBtn.querySelector('[data-pill="en"]') };

				const paint = () => {
					themeBtn.textContent = r.dataset.theme === "dark" ? "☀" : "☾";
					const lang = r.dataset.lang;
					pills.es.style.cssText = lang === "es" ? ON : OFF;
					pills.en.style.cssText = lang === "en" ? ON : OFF;
				};

				const save = (k, v) => { try { localStorage.setItem(k, v); } catch (e) {} };

				themeBtn.addEventListener("click", () => {
					r.dataset.theme = r.dataset.theme === "dark" ? "light" : "dark";
					save("mh_theme", r.dataset.theme);
					paint();
				});

				langBtn.addEventListener("click", () => {
					r.dataset.lang = r.dataset.lang === "es" ? "en" : "es";
					save("mh_lang", r.dataset.lang);
					r.lang = r.dataset.lang;
					paint();
				});

				paint();
			})();

			// Cada sección aparece al entrar en pantalla.
			(() => {
				const objetivos = document.querySelectorAll("[data-reveal]");
				if (!("IntersectionObserver" in window) || !objetivos.length) return;
				const io = new IntersectionObserver((entradas) => {
					entradas.forEach((e) => {
						if (!e.isIntersecting) return;
						e.target.classList.add("vista");
						io.unobserve(e.target);
					});
				}, { threshold: 0, rootMargin: "0px 0px -10% 0px" });
				objetivos.forEach((el) => io.observe(el));
			})();
		</script>
	</body>
</html>
