---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Tu Nombre — Portafolio",
	description = "Portafolio de trabajo de Tu Nombre: proyectos, experiencia y contacto.",
} = Astro.props;
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-neutral-950 text-neutral-100 antialiased">
		<Header />
		<main class="mx-auto w-full max-w-4xl flex-1 px-6 py-16">
			<slot />
		</main>
		<Footer />
	</body>
</html>
